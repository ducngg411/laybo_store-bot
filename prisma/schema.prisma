generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  type           ProductType
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  inventoryItems InventoryItem[]
  orders         Order[]
  variants       Variant[]

  @@index([code])
  @@index([isActive])
}

model Variant {
  id             String   @id @default(cuid())
  productId      String
  code           String   @unique
  name           String
  durationMonths Int?
  priceVnd       Int
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orders         Order[]
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([code])
  @@index([isActive])
}

model Order {
  id             String          @id @default(cuid())
  userId         BigInt
  username       String?
  productId      String
  variantId      String?
  quantity       Int
  unitPriceVnd   Int
  totalVnd       Int
  metadata       Json?
  status         OrderStatus     @default(DRAFT)
  paymentRef     String          @unique
  expiresAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  inventoryItems InventoryItem[]
  product        Product         @relation(fields: [productId], references: [id])
  variant        Variant?        @relation(fields: [variantId], references: [id])
  paymentEvents  PaymentEvent[]

  @@index([userId])
  @@index([status])
  @@index([paymentRef])
  @@index([expiresAt])
  @@index([userId, status])
}

model PaymentEvent {
  id        String   @id @default(cuid())
  orderId   String
  provider  String   @default("SEPAY")
  eventKey  String   @unique
  raw       Json
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([eventKey])
}

model InventoryItem {
  id            String          @id @default(cuid())
  productId     String
  payload       Json
  status        InventoryStatus @default(AVAILABLE)
  reservedUntil DateTime?
  orderId       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  order         Order?          @relation(fields: [orderId], references: [id])
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([status])
  @@index([orderId])
  @@index([reservedUntil])
}

enum ProductType {
  SERVICE
  DIGITAL_GOOD
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  IN_PROGRESS
  FULFILLED
  FAILED
  CANCELLED
  EXPIRED
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  SOLD
}
